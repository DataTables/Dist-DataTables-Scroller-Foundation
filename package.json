{
    "name": "datatables.net-scroller-zf",
    "description": "Scroller for DataTables with styling for [Foundation](https://get.foundation/)",
    "main": "./js/scroller.foundation.js",
    "module": "./js/scroller.foundation.mjs",
    "style": "./css/scroller.foundation.css",
    "types": "./types/scroller.foundation.d.ts",
    "version": "3.1.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Scroller",
        "Virtual Scrolling",
        "Foundation",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-scroller": "3.1.0",
        "datatables.net-zf": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/Scroller.git"
    },
    "exports": {
        ".": {
            "types": "./types/scroller.foundation.d.ts",
            "style": "./css/scroller.foundation.css",
            "import": "./js/scroller.foundation.mjs",
            "require": "./js/scroller.foundation.js",
            "default": "./js/scroller.foundation.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/scroller.foundation.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}